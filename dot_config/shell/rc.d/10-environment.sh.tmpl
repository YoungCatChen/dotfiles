# vim: set ft=sh:
is_login || return

prepend_path_dirs() {
  local dir prefix
  prefix=
  for dir in "$@"; do
    case ":$PATH:$prefix:" in
      *":$dir:"*) ;;
      *) prefix="${prefix:+$prefix:}$dir" ;;
    esac
  done
  if [ -n "$prefix" ]; then
    PATH="$prefix${PATH:+:$PATH}"
  fi
  export PATH
}

prepend_path_dirs \
{{ include ".chezmoitemplates/paths.txt" }}
unset -f prepend_path_dirs

setup_login_environment() {
  : "${LANG:=en_US.UTF-8}"
  : "${LANGUAGE:=en_US:en}"
  : "${TIME_STYLE:=iso}"
  export LANG LANGUAGE TIME_STYLE

  if command -v nvim >/dev/null 2>&1; then
    EDITOR=nvim
  else
    EDITOR=vim
  fi
  export EDITOR

  if command -v lesspipe.sh >/dev/null 2>&1; then
    LESSOPEN='|lesspipe.sh %s'
    export LESSOPEN
  fi
}

setup_login_environment
unset -f setup_login_environment
