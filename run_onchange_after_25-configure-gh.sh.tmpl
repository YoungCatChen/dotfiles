{{- /* vim: set ft=sh: */ -}}
{{- if and
  (not (env "DOTFILES_SKIP_SIDE_EFFECTS"))
  (lookPath "gh")
-}}
#!/bin/sh
set -eu

gh config set git_protocol ssh
gh alias set --clobber co 'pr checkout'
gh alias set --clobber mypr 'pr list --assignee @me --state open'
gh alias set --clobber myprs mypr
gh alias set --clobber --shell draftpr 'gh pr create --draft --assignee @me --title "$(git log --pretty=%s master..HEAD)"'
gh alias set --clobber appr 'pr review --approve'
{{- end -}}
