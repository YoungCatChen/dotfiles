#!/bin/sh

if [ "$#" -eq 0 ]; then
  printf 'usage: joincolumn columns [lines-to-skip] [file ...]\n' >&2
  exit 2
fi

columns=$1
shift
case $columns in
  ''|*[!0-9]*|0)
    printf 'joincolumn: columns must be a positive integer\n' >&2
    exit 2
    ;;
esac

skip=0
if [ "$#" -gt 0 ]; then
  case $1 in
    ''|*[!0-9]*) ;;
    *) skip=$1; shift ;;
  esac
fi

exec awk -v "columns=$columns" -v "skip=$skip" '
  BEGIN {
    line = -skip
    values[line] = ""
  }
  {
    values[line] = $0
    line++
  }
  END {
    jump = int((line + columns - 1) / columns)
    for (row = 0; row < jump; row++) {
      for (column = 0; column < columns; column++) {
        printf "%s\t", values[row + column * jump]
      }
      printf "\n"
    }
  }
' "$@"
