#!/bin/sh

if [ "$#" -eq 0 ]; then
  printf 'usage: joinline lines-per-row [file ...]\n' >&2
  exit 2
fi

lines_per_row=$1
shift
case $lines_per_row in
  ''|*[!0-9]*|0)
    printf 'joinline: lines-per-row must be a positive integer\n' >&2
    exit 2
    ;;
esac

exec awk -v "lines_per_row=$lines_per_row" '
  {
    printf "%s\t", $0
    line++
    if (line == lines_per_row) {
      printf "\n"
      line = 0
    }
  }
' "$@"
