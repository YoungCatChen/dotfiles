{{- /* vim: set ft=sh: */ -}}
{{ if and (lookPath "fish") (lookPath "curl") -}}
#!/usr/bin/env fish
# fish_plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

if not functions --query fisher
  curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
  fisher install jorgebucaran/fisher; or exit $status
else
  fisher update
end
{{ end -}}
